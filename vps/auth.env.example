# Copy to /srv/dragon-editor/auth.env, fill secrets, chmod 600.
# Never commit the filled file.
EDITOR_ORIGIN=https://dragon-editor.720108.xyz
# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDITOR_REQUEST_KEY=CHANGE_ME_64_HEX
# 16-128 chars. This seeds the tianyi admin on first boot; change it at once.
EDITOR_DEFAULT_PASSWORD=CHANGE_ME_16_PLUS_CHARS
# Whole-site single user (整站单用户在线): 1 = reject a new login while any
# valid session exists (409 SINGLE_USER_ONLINE); logout/expiry frees the seat.
EDITOR_SINGLE_USER=1
